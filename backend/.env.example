# =====================================================================
# CivicPulse AI / CiviSense AI - Backend Configuration
# =====================================================================

# 1. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# For Local Development (Default):
# If DATABASE_URL is not set, a persistent SQLite database is automatically used at backend/civisense_data.db
# DATABASE_URL=sqlite:///civisense_data.db

# For Production (Render / Supabase / PostgreSQL):
# IMPORTANT: On Render's ephemeral filesystem, provide a persistent PostgreSQL or Supabase URL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# OR (Supabase Session Pooler):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# OR (Render PostgreSQL internal / external):
# DATABASE_URL=postgresql://civisense_user:[PASSWORD]@dpg-...-a.oregon-postgres.render.com/civisense_db

# Other supported alias variable names:
# POSTGRES_URL=
# SUPABASE_DB_URL=
# SUPABASE_DATABASE_URL=
